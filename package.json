{
  "name": "session-party",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "10.28.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:reset": "tsx scripts/dev-reset.ts",
    "dev:seed": "tsx scripts/seed.ts",
    "dev:local": "tsx scripts/local-dev.ts",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "gen": "tsx scripts/gen.ts",
    "check:registry": "pnpm gen --check",
    "check:types": "tsc -b",
    "check": "pnpm check:registry && pnpm check:types",
    "test:worker": "vitest run",
    "test:migrations": "vitest run src/server/migration-parity.test.ts",
    "smoke:local": "tsx scripts/local-smoke.ts",
    "test": "pnpm test:worker",
    "ci": "pnpm check:registry && pnpm check:types && pnpm test:worker && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply session-party --local",
    "db:migrate:remote": "wrangler d1 migrations apply session-party --remote"
  },
  "dependencies": {
    "agents": "^0.20.1",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "hono": "^4.13.1",
    "nanoid": "^6.0.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
