{
  "name": "session-party",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "10.28.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:reset": "tsx scripts/dev-reset.ts",
    "dev:seed": "tsx scripts/seed.ts",
    "demo:hydrate": "tsx scripts/demo-hydrate.ts",
    "demo:promote": "tsx scripts/demo-promote.ts",
    "dev:local": "tsx scripts/local-dev.ts",
    "dev:service": "pnpm dev:reset && pnpm dev:local",
    "build": "vite build",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "gen": "tsx --tsconfig tsconfig.worker.json scripts/gen.ts",
    "check:registry": "pnpm gen --check",
    "check:types": "tsc -b",
    "check": "pnpm check:registry && pnpm check:types && pnpm rubric:validate",
    "rubric:validate": "tsx scripts/rubric.ts validate",
    "rubric:test": "tsx --test scripts/rubric/*.node-test.ts",
    "rubric:run": "tsx scripts/rubric.ts run",
    "rubric:gate": "tsx scripts/rubric.ts gate",
    "rubric:baseline": "tsx scripts/rubric.ts baseline",
    "test:worker": "vitest run",
    "test:audit-browser": "vitest run --config src/client/vitest.audit-browser.config.ts",
    "test:qa": "playwright test --config playwright.qa.config.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:visual-tools": "node --test tools/visual-regression/*.node-test.mjs",
    "visual:stories:capture": "pnpm test:storybook",
    "visual:stories:compare": "node tools/visual-regression/render-config.mjs storybook && reg-suit run -c .regconfig.storybook.json",
    "visual:pages:capture": "playwright test --config playwright.config.ts",
    "visual:pages:compare": "node tools/visual-regression/render-config.mjs pages && reg-suit run -c .regconfig.pages.json",
    "walkthrough:record": "tsx scripts/walkthrough/record.ts && tsx scripts/walkthrough/assemble.ts",
    "walkthrough:assemble": "tsx scripts/walkthrough/assemble.ts",
    "walkthrough:v2": "pnpm walkthrough:v2:record && pnpm walkthrough:v2:assemble",
    "walkthrough:v2:record": "tsx scripts/walkthrough/v2/record.ts",
    "walkthrough:v2:assemble": "tsx scripts/walkthrough/v2/assemble.ts",
    "test:migrations": "vitest run src/server/migration-parity.test.ts",
    "smoke:local": "tsx scripts/local-smoke.ts",
    "test": "pnpm test:worker",
    "ci": "pnpm check && pnpm rubric:test && pnpm test:worker && pnpm test:audit-browser && pnpm test:storybook && pnpm test:visual-tools && pnpm build && pnpm storybook:build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "agents": "^0.20.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "hono": "^4.13.1",
    "lucide-react": "^1.30.0",
    "nanoid": "^6.0.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "posthog-js": "^1.414.0",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7.85.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@argos-ci/storybook": "^5.3.4",
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@playwright/test": "1.61.0",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.13.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reg-publish-s3-plugin": "^0.14.4",
    "reg-suit": "^0.14.5",
    "sharp": "^0.35.0",
    "storybook": "10.5.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "cloudflare": {
    "bindings": {
      "APP_URL": {
        "description": "The public origin for this installation, such as `https://events.example.com`. Use the same hostname when you connect the Custom Domain."
      },
      "INITIAL_ADMIN_EMAIL": {
        "description": "Recommended for self-hosting: the first administrator email. When set, unknown emails cannot register unless they have a reviewer invitation or managed-speaker record. Leave blank only for an open-registration service."
      },
      "MAIL_FROM": {
        "description": "A sender on a domain onboarded to [Cloudflare Email Service](https://developers.cloudflare.com/email-service/get-started/), such as `Session Party <welcome@example.com>`."
      },
      "POSTHOG_KEY": {
        "description": "Optional public PostHog project key. Leave this and `POSTHOG_HOST` blank to send no product analytics."
      },
      "POSTHOG_HOST": {
        "description": "Optional HTTPS PostHog origin, such as `https://us.i.posthog.com`. Analytics activates only when this and `POSTHOG_KEY` are both set."
      },
      "SESSION_SECRET": {
        "description": "Generate a unique signing secret with `openssl rand -hex 32`. Rotating it signs every user out."
      },
      "TURNSTILE_HOSTNAMES": {
        "description": "Comma-separated hostnames accepted by the Turnstile widget, such as `events.example.com`."
      },
      "TURNSTILE_SECRET": {
        "description": "The secret key for a [Cloudflare Turnstile widget](https://developers.cloudflare.com/turnstile/get-started/)."
      },
      "TURNSTILE_SITE_KEY": {
        "description": "The site key for the Turnstile widget configured for this installation's public hostname."
      }
    }
  }
}
