{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "session-party",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/parties/*", "/event/*", "/events/*", "/embed/*"]
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "session-party",
      "database_id": "2cb93013-05e8-48bc-865d-f99a0a0096da",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "session-party-files" }],
  "durable_objects": {
    "bindings": [
      { "name": "EVENT_ROOM", "class_name": "EventRoom" },
      { "name": "SCHEDULER", "class_name": "Scheduler" },
      { "name": "AIRTABLE_SYNC", "class_name": "AirtableSyncLane" },
      { "name": "AIRTABLE_RATE_LIMITER", "class_name": "AirtableRateLimiter" },
      { "name": "MCP_OBJECT", "class_name": "SessionPartyMcp" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EventRoom", "Scheduler", "SessionPartyMcp"] },
    { "tag": "v2", "new_sqlite_classes": ["AirtableSyncLane", "AirtableRateLimiter"] }
  ],
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_URL": "https://sessionparty.com",
    // Set this to the self-hosted owner email to bootstrap closed registration.
    "INITIAL_ADMIN_EMAIL": "",
    // Keep closed for self-hosting. Change to open only for an intentional multi-tenant service.
    "REGISTRATION_MODE": "closed",
    "MAIL_FROM": "Session Party <welcome@sessionparty.com>",
    // Optional public project settings. Analytics remains disabled while either value is blank.
    "POSTHOG_KEY": "",
    "POSTHOG_HOST": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAELTRHiRum336lV9",
    "TURNSTILE_HOSTNAMES": "sessionparty.com"
  },
  "secrets": {
    "required": ["SESSION_SECRET", "TURNSTILE_SECRET"]
  },
  "env": {
    "preview": {
      "name": "session-party-preview",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
      // PR previews are UI-only until isolated preview storage is provisioned.
      // Keep this explicit because triggers are inherited from the top-level config.
      "triggers": { "crons": [] },
      "durable_objects": {
        "bindings": [
          { "name": "EVENT_ROOM", "class_name": "EventRoom" },
          { "name": "SCHEDULER", "class_name": "Scheduler" },
          { "name": "AIRTABLE_SYNC", "class_name": "AirtableSyncLane" },
          { "name": "AIRTABLE_RATE_LIMITER", "class_name": "AirtableRateLimiter" },
          { "name": "MCP_OBJECT", "class_name": "SessionPartyMcp" }
        ]
      },
      "send_email": [], // Preview mail is captured by the fake adapter; never bind live Email.
      "vars": {
        "PREVIEW_MODE": "1",
        "APP_URL": "https://preview.invalid",
        "INITIAL_ADMIN_EMAIL": "",
        "REGISTRATION_MODE": "closed",
        "MAIL_FROM": "Session Party Preview <welcome@sessionparty.com>",
        "POSTHOG_KEY": "",
        "POSTHOG_HOST": "",
        "TURNSTILE_SITE_KEY": "preview-fake",
        "TURNSTILE_HOSTNAMES": "invalid"
      }
    }
  }
  // Secrets (wrangler secret put): SESSION_SECRET, TURNSTILE_SECRET, ACCELEVENTS_API_TOKEN, AIRTABLE_PAT
}
